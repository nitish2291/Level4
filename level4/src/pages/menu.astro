---
import BaseLayout from "../layouts/BaseLayout.astro";
import menu from "../content/menu.json";
---

<BaseLayout>

<section class="menu-page">

<h1>Our Menu</h1>

<div class="menu-nav">

<label class="veg-switch-inline">

<a href="/menu.pdf" target="_blank" class="menu-full-btn">
  Browse Full Menu
</a>

<input type="checkbox" id="vegMode">

<span class="veg-slider"></span>

<span class="veg-text">Veg Mode 🌿</span>

</label>
{menu.categories.map(category => (

<a href={`#${category.name.replace(/\s+/g,'-').toLowerCase()}`}>
{category.name}
</a>

))}

</div>

{menu.categories.map(category => (

<div
class="menu-category"
id={category.name.replace(/\s+/g,'-').toLowerCase()}
>

<h2>{category.name}</h2>

<div class="menu-grid">

{category.items.map(item => (

<div class={`menu-card ${item.type}`}>

<img
  src={item.image || "/images/menu/dish.png"}
  alt={item.name}
  loading="lazy"
/>

<div class="menu-info">

<h3>
{item.name}
<span class="food-icon">
{
item.type === "veg" ? "🌱" :
item.type === "nonveg" ? "🍗" :
item.type === "egg" ? "🥚" :
item.type === "drinks" ? "🍹" :
item.type === "dessert" ? "🍰" : ""
}
</span>
</h3>

<span class="price">₹{item.price}</span>

</div>

</div>

))}

</div>  <!-- menu-grid -->

</div>  <!-- menu-category -->

))}

</section>

</BaseLayout>

<script src="/src/scripts/menu-scroll.js"></script>

<script>
const vegToggle = document.getElementById("vegMode");
const categories = Array.from(document.querySelectorAll(".menu-category"));
const navLinks = Array.from(document.querySelectorAll(".menu-nav a"));

// 🔥 Pre-map nav links
const navMap = {};
navLinks.forEach(link => {
  const id = link.getAttribute("href").replace("#", "");
  navMap[id] = link;
});

// 🔥 Ensure initial visual state is consistent
categories.forEach(category => {
  category.style.opacity = "1";
  category.style.transform = "scale(1)";
});

vegToggle.addEventListener("change", () => {

  document.body.classList.toggle("veg-active");

  let firstVisibleCategory = null;

  categories.forEach(category => {

    const items = category.querySelectorAll(".menu-card");
    let visibleCount = 0;

    // 🔥 Filter items
    items.forEach(item => {
      const isNonVeg =
        item.classList.contains("nonveg") ||
        item.classList.contains("egg");

      const shouldHide = vegToggle.checked && isNonVeg;

      item.style.display = shouldHide ? "none" : "block";

      if (!shouldHide) visibleCount++;
    });

    const isVisible = visibleCount > 0;

    // 🔥 Clear any pending hide timeout (fix race condition)
    if (category.hideTimeout) {
      clearTimeout(category.hideTimeout);
    }

    if (!isVisible) {
      // fade out
      category.style.opacity = "0";
      category.style.transform = "scale(0.98)";

      category.hideTimeout = setTimeout(() => {
        category.style.display = "none";
      }, 250);

    } else {
      // show first
      category.style.display = "block";

      // animate in
      setTimeout(() => {
        category.style.opacity = "1";
        category.style.transform = "scale(1)";
      }, 10);
    }

    // 🔥 Nav sync
    const id = category.id;
    if (navMap[id]) {
      navMap[id].style.display = isVisible ? "inline-block" : "none";
    }

    // track first visible
    if (isVisible && !firstVisibleCategory) {
      firstVisibleCategory = category;
    }

  });

  // 🔥 Safer scroll behavior
  if (firstVisibleCategory && window.scrollY < 200) {
    firstVisibleCategory.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }

});
</script>